# Core API Keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
E2B_API_KEY=your_e2b_api_key_here

# LangSmith Observability (Optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-system

# Dynamic Fallback:
# Leave blank for local development to fallback to MemorySaver checkpointer and SQLite.
# Fill in for production or when running via docker-compose.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/multiagent

# LLM & Step Settings
MODEL_NAME=gemini-2.0-flash
MAX_STEPS=15
