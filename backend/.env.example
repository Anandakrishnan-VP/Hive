# Core API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
E2B_API_KEY=your_e2b_api_key_here

# LangSmith Observability (Optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-system

# Database configuration:
# Leave blank for local development to fallback to MemorySaver checkpointer and SQLite.
# Fill in with your Supabase database URL for persistence.
DATABASE_URL=postgresql://user:password@localhost:5432/multiagent

# Supabase Authentication (Retrieve from Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here (Optional if using SUPABASE_URL for asymmetric keys)


# LLM & Step Settings
MODEL_NAME=llama-3.3-70b-versatile
MAX_STEPS=15

# Agent-specific model configurations
SUPERVISOR_MODEL=groq/llama-3.3-70b-versatile
RESEARCHER_MODEL=gemini/gemini-2.5-flash
CODER_MODEL=gemini/gemini-2.5-flash
WRITER_MODEL=groq/llama-3.3-70b-versatile
CRITIC_MODEL=groq/llama-3.1-8b-instant

